# Copy to .env and edit. Read by compose.yml (docker compose / podman compose).

# Hugging Face repo id, or a path inside the container.
MODEL=cyankiwi/Qwen3.8-27B-AWQ-INT4
SERVED_NAME=qwen3.8-27b

# Which GPUs (by index) and how many to split the model across.
GPUS=0
TP=1
MAX_LEN=8192

# 127.0.0.1 = this machine only. 0.0.0.0 = your whole network.
BIND=127.0.0.1
PORT=8000

# RDNA2 cousins (RX 6700/6600 class): uncomment.
# HSA_OVERRIDE_GFX_VERSION=10.3.0

# Hosts where GPU-to-GPU P2P is broken (many VMs, some Intel boards):
# NCCL_P2P_DISABLE=1
# VLLM_RDNA_AR=0

# Host group IDs that own /dev/dri and /dev/kfd. Plain numbers only, no quotes or brackets.
# Find them with:  stat -c %g /dev/dri/card0 /dev/kfd   (or: getent group video render, third field)
VIDEO_GID=44
RENDER_GID=992

# Rootless Podman: edit vllm-compose.yml to  group_add: [keep-groups]

# Gated models:
# HF_TOKEN=

EXTRA_ARGS=--language-model-only --skip-mm-profiling --trust-remote-code
